<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<RootNamespace>Interstellar</RootNamespace>
		<AssemblyName>Interstellar.Client</AssemblyName>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<DebugSymbols>false</DebugSymbols>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
		<PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" PrivateAssets="all" />
		<PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
		<PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="Concentus" Version="2.2.2" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\*.png" />
		<EmbeddedResource Include="Resources\Locales\*.xml" />
	</ItemGroup>

	<Target Name="StageEmbeddedLibraries" BeforeTargets="SplitResourcesByCulture" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<_EmbeddedLib Include="@(ReferenceCopyLocalPaths)"
						  Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'NAudio'
                            Or '%(ReferenceCopyLocalPaths.Filename)' == 'NAudio.Core'
                            Or '%(ReferenceCopyLocalPaths.Filename)' == 'NAudio.Asio'
                            Or '%(ReferenceCopyLocalPaths.Filename)' == 'NAudio.Midi'
                            Or '%(ReferenceCopyLocalPaths.Filename)' == 'NAudio.Wasapi'
                            Or '%(ReferenceCopyLocalPaths.Filename)' == 'NAudio.WinMM'
                            Or '%(ReferenceCopyLocalPaths.Filename)' == 'Concentus'" />
		</ItemGroup>
		<ItemGroup>
			<EmbeddedResource Include="@(_EmbeddedLib)">
				<LogicalName>Lib.%(Filename)%(Extension)</LogicalName>
			</EmbeddedResource>
		</ItemGroup>
	</Target>
	
	<Target Name="CollectDependencies" AfterTargets="Build">
		<ItemGroup>
			<_DepDlls Include="$(TargetDir)*.dll" Exclude="$(TargetDir)Interstellar.Client.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(_DepDlls)" DestinationFolder="$(ProjectDir)Libs" SkipUnchangedFiles="true" />
		<Message Text="Collected @(_DepDlls-&gt;Count()) dependency DLL(s) into Libs/ — rebuild to embed them." Importance="high" />
	</Target>

</Project>
