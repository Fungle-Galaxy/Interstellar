  <string name="vc.settings.help.keybinds.settings">Opens this settings panel. Delete or Backspace clears the key, Esc cancels the capture.</string>
  <string name="vc.settings.help.keybinds.publicLobby">Opens this settings panel on the public lobby list.</string>
  <string name="vc.settings.help.keybinds.playerVolume">Opens this settings panel on the per-player volume list.</string>
  <string name="vc.settings.help.keybinds.cycleMic">Mutes and unmutes your microphone, switching to the impostor radio channel when that is enabled.</string>
  <string name="vc.settings.help.keybinds.toggleSpeaker">Mutes and unmutes everything you hear.</string>
