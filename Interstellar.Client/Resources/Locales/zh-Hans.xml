  <string name="vc.settings.transport.p2p">P2P 直连</string>
  <string name="vc.settings.transport.relay">服务器中转</string>
  <string name="vc.settings.micLevel">输入电平</string>
  <string name="vc.settings.micTest">麦克风测试</string>
  <string name="vc.settings.speakerTest">扬声器测试</string>
  <string name="vc.settings.testStart">开始</string>
